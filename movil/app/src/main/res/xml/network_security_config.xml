<?xml version="1.0" encoding="utf-8"?>
<!-- Solo desarrollo local puede usar HTTP sin cifrar; producción debe ser HTTPS.
     10.0.2.2 = localhost de la máquina host visto desde el emulador.
     192.168.100.7 / 10.161.240.179 = IPs LAN que ha tenido la Mac de desarrollo en distintas
     redes WiFi, para probar desde un celular físico en la misma red
     (ver redicapBaseUrl en app/build.gradle.kts). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.100.7</domain>
        <domain includeSubdomains="false">10.161.240.179</domain>
    </domain-config>
</network-security-config>
